// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Bootstrap placeholder model
// This will be removed when real entities are added
// ============================================================================

model HealthCheck {
  id        String   @id @default(cuid())
  checkedAt DateTime @default(now())

  @@map("health_checks")
}

// ============================================================================
// Core V1 MVP Entities
// ============================================================================

/// Inbound messages from WhatsApp (or other channels)
/// Implements idempotency via unique constraint on messageId
model InboundMessage {
  id        String   @id @default(cuid())
  messageId String   @unique @map("message_id") // Provider unique ID (WhatsApp message_id)
  from      String   // Phone number or user identifier
  timestamp DateTime // Message timestamp from provider
  text      String?  // Text content
  mediaType String?  @map("media_type") // image, document, audio, video
  mediaUrl  String?  @map("media_url") // URL to media attachment
  processed Boolean  @default(false) // Processing status
  createdAt DateTime @default(now()) @map("created_at")

  @@map("inbound_messages")
  @@index([from])
  @@index([timestamp])
}

// ============================================================================
// PR-02: Customer, Merchant, Conversation (identity + session)
// ============================================================================

/// Merchant represents a business using the platform
model Merchant {
  id             String    @id @default(cuid())
  name           String
  whatsappNumber String    @map("whatsapp_number")
  apiKey         String    @unique @map("api_key")
  industry       Industry? // PR-11: Playbook industry
  playbookConfig Json?     @map("playbook_config") // PR-11: Custom playbook overrides
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  conversations  Conversation[]
  categories     Category[]
  products       Product[]
  outboxMessages OutboxMessage[]
  channels       Channel[]   // PR-03.11: Multi-channel support
  identities     MerchantIdentity[] // PR-12: OIDC identities
  sessions       Session[]   // PR-12: Auth sessions
  carts          Cart[]      // PR-04: Shopping carts

  @@map("merchants")
}

/// Industry enum for playbook selection (PR-11)
enum Industry {
  ropa
  belleza
  minimarket
}

/// Channel type for multi-channel support (PR-03.11)
enum ChannelType {
  WHATSAPP
  INSTAGRAM
}

/// Channel status for connection health (PR-13)
enum ChannelStatus {
  pending
  connected
  error
}

/// Customer represents an end-user (identity resolved by phone)
model Customer {
  id        String    @id @default(cuid())
  phone     String    @unique // Normalized phone number (e.g., +573001234567)
  name      String?
  language  String    @default("es") // ISO 639-1 code
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  conversations Conversation[]
  carts         Cart[]         // PR-04: Shopping carts

  @@map("customers")
  @@index([phone])
}

/// Conversation represents a chat session between customer and merchant
model Conversation {
  id            String    @id @default(cuid())
  customerId    String    @map("customer_id")
  merchantId    String    @map("merchant_id")
  channelId     String?   @map("channel_id") // PR-03.11: FK to Channel (nullable for backwards compat)
  channel       String    // whatsapp, webchat, instagram
  status        String    @default("active") // active, closed, handoff
  lastMessageAt DateTime? @map("last_message_at")
  // PR-03.10: Memory fields for conversational continuity
  summary           String?   @db.Text // Conversational summary (max 1000 chars)
  memoryFacts       Json?     @map("memory_facts") // Persistent facts extracted from conversation
  lastIntent        String?   @map("last_intent") // Last detected intent
  lastSummarizedAt  DateTime? @map("last_summarized_at") // Last time summary was generated
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  customer    Customer     @relation(fields: [customerId], references: [id])
  merchant    Merchant     @relation(fields: [merchantId], references: [id])
  channelRef  Channel?     @relation(fields: [channelId], references: [id]) // PR-03.11
  messageLogs MessageLog[] // PR-03.10: Message history

  @@map("conversations")
  @@index([customerId])
  @@index([merchantId])
  @@index([customerId, channel])
  @@index([status])
}

// ============================================================================
// PR-03.10: Message Logs (conversational memory with TTL)
// ============================================================================

/// Direction enum for message logs
enum MessageDirection {
  IN  // Inbound from user
  OUT // Outbound from bot
}

/// MessageLog stores conversation history with TTL for memory retention
model MessageLog {
  id                 String           @id @default(cuid())
  conversationId     String           @map("conversation_id")
  merchantId         String           @map("merchant_id") // Denormalized for multi-tenant queries
  direction          MessageDirection // IN or OUT
  providerMessageId  String?          @map("provider_message_id") // Provider ID for traceability (not used for dedupe)
  text               String?          @db.Text // Message text content
  mediaType          String?          @map("media_type") // image, document, audio, video
  expiresAt          DateTime         @map("expires_at") // TTL for automatic cleanup
  createdAt          DateTime         @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("message_logs")
  @@index([conversationId, createdAt]) // For ordered queries (last K messages)
  @@index([expiresAt]) // For cleanup job
  @@index([merchantId]) // For multi-tenant queries
}

// ============================================================================
// PR-03: Catalog (Product, Category, ProductVariant)
// ============================================================================

/// Category groups products for easier navigation
model Category {
  id         String    @id @default(cuid())
  name       String
  merchantId String    @map("merchant_id")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  merchant Merchant  @relation(fields: [merchantId], references: [id])
  products Product[]

  @@map("categories")
  @@unique([merchantId, name])
  @@index([merchantId])
}

/// Product represents an item in the catalog
model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  categoryId  String   @map("category_id")
  merchantId  String   @map("merchant_id")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category Category          @relation(fields: [categoryId], references: [id])
  merchant Merchant          @relation(fields: [merchantId], references: [id])
  variants ProductVariant[]

  @@map("products")
  @@index([merchantId])
  @@index([categoryId])
  @@index([merchantId, isActive])
}

/// ProductVariant represents a specific SKU with price and stock
model ProductVariant {
  id        String   @id @default(cuid())
  productId String   @map("product_id")
  sku       String // Required SKU for idempotency in imports
  name      String // Variant name (e.g., "Talla M", "Color Rojo")
  price     Decimal  @db.Decimal(10, 2) // Price with 2 decimal places
  stock     Int      @default(0) // Available stock
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product   Product    @relation(fields: [productId], references: [id])
  cartItems CartItem[] // PR-04: Cart items

  @@map("product_variants")
  @@unique([productId, sku]) // Ensure SKU is unique per product
  @@index([productId])
  @@index([isActive])
}

// ============================================================================
// PR-03.9: Transactional Outbox (Outbound WhatsApp)
// ============================================================================

enum OutboxChannel {
  WHATSAPP
}

enum OutboxMessageType {
  SEND_TEXT
}

enum OutboxMessageStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

/// Transactional outbox for reliable WhatsApp outbound messaging
/// Guarantees eventual delivery without dual-write race conditions
model OutboxMessage {
  id             String              @id @default(cuid())
  merchantId     String              @map("merchant_id")
  conversationId String?             @map("conversation_id") // PR-03.10: For outbound message logging
  channelId      String?             @map("channel_id") // PR-03.11: FK to Channel (nullable for backwards compat)
  channel        OutboxChannel
  type           OutboxMessageType
  to             String
  payloadJson    Json                @map("payload_json")
  dedupeKey      String?             @map("dedupe_key")

  status      OutboxMessageStatus @default(PENDING)
  attempts    Int                 @default(0)
  nextRetryAt DateTime            @default(now()) @map("next_retry_at")
  lockedAt    DateTime?           @map("locked_at")
  lockedBy    String?             @map("locked_by")
  lastError   String?             @map("last_error")

  providerMessageId String?       @map("provider_message_id")
  sentAt            DateTime?     @map("sent_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  merchant   Merchant @relation(fields: [merchantId], references: [id])
  channelRef Channel? @relation(fields: [channelId], references: [id]) // PR-03.11

  @@map("outbox_messages")
  @@index([merchantId])
  @@index([status, nextRetryAt])
  @@unique([merchantId, dedupeKey])
}

// ============================================================================
// PR-03.11: Channel (Multi-channel support)
// ============================================================================

/// Channel represents a messaging channel (WhatsApp, Instagram, etc.) for a merchant
/// Each channel has its own credentials and external identifier
model Channel {
  id                String        @id @default(cuid())
  merchantId        String        @map("merchant_id")
  type              ChannelType
  externalId        String        @map("external_id") // phone_number_id for WhatsApp, page_id for Instagram
  displayName       String        @map("display_name") // Human-readable name (e.g., "Sucursal Centro")
  credentials       Json // { accessToken, appSecret?, phoneNumberId?, wabaId? } - TODO: encrypt in future
  isActive          Boolean       @default(true) @map("is_active")
  // PR-13: Meta Embedded Signup fields
  wabaId            String?       @map("waba_id") // WhatsApp Business Account ID
  status            ChannelStatus @default(pending)
  statusReason      String?       @map("status_reason") @db.Text
  webhookSubscribed Boolean       @default(false) @map("webhook_subscribed")
  lastWebhookAt     DateTime?     @map("last_webhook_at")
  // PR-14: Channel health tracking
  lastErrorAt       DateTime?     @map("last_error_at")
  errorCount        Int           @default(0) @map("error_count")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  merchant       Merchant        @relation(fields: [merchantId], references: [id])
  conversations  Conversation[]
  outboxMessages OutboxMessage[]

  @@unique([type, externalId])
  @@map("channels")
  @@index([merchantId])
  @@index([type, externalId])
  @@index([isActive])
}

// ============================================================================
// PR-12: Auth OIDC - Social Login (Google + Microsoft)
// ============================================================================

/// OidcProvider enum for supported identity providers
enum OidcProvider {
  GOOGLE
  MICROSOFT
}

/// MerchantIdentity links merchants to external OIDC providers
model MerchantIdentity {
  id          String       @id @default(cuid())
  merchantId  String       @map("merchant_id")
  provider    OidcProvider
  oidcSubject String       @map("oidc_subject") // 'sub' claim from ID token
  email       String
  createdAt   DateTime     @default(now()) @map("created_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([provider, oidcSubject])
  @@map("merchant_identities")
  @@index([merchantId])
  @@index([email])
}

/// Session stores server-side sessions for authenticated merchants
model Session {
  id        String   @id @default(cuid())
  sessionId String   @unique @map("session_id") // UUID for cookie
  merchantId String  @map("merchant_id")
  expiresAt DateTime @map("expires_at")
  userAgent String?  @map("user_agent")
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@map("sessions")
  @@index([sessionId])
  @@index([expiresAt])
  @@index([merchantId])
}

// ============================================================================
// PR-04: Cart & CartItem (conversational e-commerce)
// ============================================================================

/// CartStatus enum for cart lifecycle
enum CartStatus {
  active
  abandoned
  completed
}

/// Cart represents a shopping cart for a customer
model Cart {
  id         String     @id @default(cuid())
  customerId String     @map("customer_id")
  merchantId String     @map("merchant_id")
  status     CartStatus @default(active)
  expiresAt  DateTime   @map("expires_at")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  customer Customer   @relation(fields: [customerId], references: [id])
  merchant Merchant   @relation(fields: [merchantId], references: [id])
  items    CartItem[]

  @@map("carts")
  @@index([customerId, merchantId, status])
  @@index([expiresAt])
}

/// CartItem represents a line item in a cart
model CartItem {
  id            String   @id @default(cuid())
  cartId        String   @map("cart_id")
  variantId     String   @map("variant_id")
  quantity      Int
  priceSnapshot Decimal  @db.Decimal(10, 2) @map("price_snapshot") // Price at add time
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId]) // Idempotency: 1 entry per variant in cart
  @@map("cart_items")
  @@index([cartId])
}

