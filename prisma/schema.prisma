// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Bootstrap placeholder model
// This will be removed when real entities are added
// ============================================================================

model HealthCheck {
  id        String   @id @default(cuid())
  checkedAt DateTime @default(now())

  @@map("health_checks")
}

// ============================================================================
// Core V1 MVP Entities
// ============================================================================

/// Inbound messages from WhatsApp (or other channels)
/// Implements idempotency via unique constraint on messageId
model InboundMessage {
  id        String   @id @default(cuid())
  messageId String   @unique @map("message_id") // Provider unique ID (WhatsApp message_id)
  from      String // Phone number or user identifier
  timestamp DateTime // Message timestamp from provider
  text      String? // Text content
  mediaType String?  @map("media_type") // image, document, audio, video
  mediaUrl  String?  @map("media_url") // URL to media attachment
  processed Boolean  @default(false) // Processing status
  createdAt DateTime @default(now()) @map("created_at")

  @@index([from])
  @@index([timestamp])
  @@map("inbound_messages")
}

// ============================================================================
// PR-02: Customer, Merchant, Conversation (identity + session)
// ============================================================================

/// Merchant represents a business using the platform
model Merchant {
  id             String    @id @default(cuid())
  name           String
  whatsappNumber String    @map("whatsapp_number")
  apiKey         String    @unique @map("api_key")
  industry       Industry? // PR-11: Playbook industry
  playbookConfig Json?     @map("playbook_config") // PR-11: Custom playbook overrides
  botPaused      Boolean        @default(false) @map("bot_paused") // PR-05.1: Pause bot processing for customers
  status         MerchantStatus @default(onboarding) @map("status") // PR-OB-01: Onboarding lifecycle
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  conversations  Conversation[]
  categories     Category[]
  products       Product[]
  outboxMessages OutboxMessage[]
  channels       Channel[] // PR-03.11: Multi-channel support
  identities     MerchantIdentity[] // PR-12: OIDC identities
  sessions       Session[] // PR-12: Auth sessions
  carts          Cart[] // PR-04: Shopping carts
  merchantConfig MerchantConfig? // PR-04.5: Merchant operational config
  orders         Order[] // PR-05: Orders
  tickets        Ticket[] // PR-07: Support tickets

  @@map("merchants")
}

/// MerchantConfig stores operational settings per merchant (PR-04.5)
/// 1:1 with Merchant — created on first access with industry preset
model MerchantConfig {
  id              String   @id @default(cuid())
  merchantId      String   @unique @map("merchant_id")
  paymentMethods  Json     @map("payment_methods") // PaymentMethodConfig[]
  shippingConfig  Json     @map("shipping_config") // ShippingConfig
  returnPolicy    String?  @map("return_policy") @db.Text
  businessHours   String?  @map("business_hours") @db.VarChar(200)
  currency        String   @default("COP")
  orderCodePrefix String   @default("ORD") @map("order_code_prefix")
  autoConfirmCod  Boolean  @default(true) @map("auto_confirm_cod")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@map("merchant_configs")
}

/// Industry enum for playbook selection (PR-11)
enum Industry {
  ropa
  belleza
  minimarket
}

/// MerchantStatus enum for onboarding lifecycle (PR-OB-01)
enum MerchantStatus {
  onboarding
  active
  paused
}

/// ConversationType distinguishes customer conversations from merchant admin sessions (PR-05.1)
enum ConversationType {
  CUSTOMER       // Default: end-user conversation (sales flow)
  MERCHANT_ADMIN // Merchant sending admin commands via WhatsApp
}

/// Channel type for multi-channel support (PR-03.11)
enum ChannelType {
  WHATSAPP
  INSTAGRAM
}

/// Channel status for connection health (PR-13)
enum ChannelStatus {
  pending
  connected
  error
}

/// Customer represents an end-user (identity resolved by phone)
model Customer {
  id        String   @id @default(cuid())
  phone     String   @unique // Normalized phone number (e.g., +573001234567)
  name      String?
  language  String   @default("es") // ISO 639-1 code
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  conversations Conversation[]
  carts         Cart[] // PR-04: Shopping carts
  orders        Order[] // PR-05: Orders
  tickets       Ticket[] // PR-07: Support tickets

  @@index([phone])
  @@map("customers")
}

/// Conversation represents a chat session between customer and merchant
model Conversation {
  id               String           @id @default(cuid())
  customerId       String           @map("customer_id")
  merchantId       String           @map("merchant_id")
  channelId        String?          @map("channel_id") // PR-03.11: FK to Channel (nullable for backwards compat)
  channel          String // whatsapp, webchat, instagram
  type             ConversationType @default(CUSTOMER) // PR-05.1: CUSTOMER or MERCHANT_ADMIN
  status           String           @default("active") // active, closed, handoff
  lastMessageAt    DateTime?        @map("last_message_at")
  // PR-03.10: Memory fields for conversational continuity
  summary          String?          @db.Text // Conversational summary (max 1000 chars)
  memoryFacts      Json?            @map("memory_facts") // Persistent facts extracted from conversation
  lastIntent       String?          @map("last_intent") // Last detected intent
  lastSummarizedAt DateTime?        @map("last_summarized_at") // Last time summary was generated
  metadata         Json?            // PR-05: Generic metadata (checkout state, etc.)
  handoffActive    Boolean          @default(false) @map("handoff_active") // PR-05.2: relay bidireccional activo
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  customer    Customer     @relation(fields: [customerId], references: [id])
  merchant    Merchant     @relation(fields: [merchantId], references: [id])
  channelRef  Channel?     @relation(fields: [channelId], references: [id]) // PR-03.11
  messageLogs MessageLog[] // PR-03.10: Message history
  handoffs    Handoff[]    // PR-08: Human handoff sessions

  @@index([customerId])
  @@index([merchantId])
  @@index([customerId, channel])
  @@index([status])
  @@map("conversations")
}

// ============================================================================
// PR-03.10: Message Logs (conversational memory with TTL)
// ============================================================================

/// Direction enum for message logs
enum MessageDirection {
  IN // Inbound from user
  OUT // Outbound from bot
}

/// MessageLog stores conversation history with TTL for memory retention
model MessageLog {
  id                String           @id @default(cuid())
  conversationId    String           @map("conversation_id")
  merchantId        String           @map("merchant_id") // Denormalized for multi-tenant queries
  direction         MessageDirection // IN or OUT
  providerMessageId String?          @map("provider_message_id") // Provider ID for traceability (not used for dedupe)
  text              String?          @db.Text // Message text content
  mediaType         String?          @map("media_type") // image, document, audio, video
  source            String?          // PR-05.2: 'relay' for relayed messages, null for normal
  expiresAt         DateTime         @map("expires_at") // TTL for automatic cleanup
  createdAt         DateTime         @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt]) // For ordered queries (last K messages)
  @@index([expiresAt]) // For cleanup job
  @@index([merchantId]) // For multi-tenant queries
  @@map("message_logs")
}

// ============================================================================
// PR-03: Catalog (Product, Category, ProductVariant)
// ============================================================================

/// Category groups products for easier navigation
model Category {
  id         String   @id @default(cuid())
  name       String
  merchantId String   @map("merchant_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  merchant Merchant  @relation(fields: [merchantId], references: [id])
  products Product[]

  @@unique([merchantId, name])
  @@index([merchantId])
  @@map("categories")
}

/// Product represents an item in the catalog
model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  brand       String? // PR-03.5.2: Product brand
  tags        String[] // PR-03.5.2: Keywords for enhanced search
  imageUrls   String[] @map("image_urls") // PR-03.5.2: Product images
  searchText  String?  @map("search_text") // PR-03.5.2: Derived field for FTS (auto-generated)
  categoryId  String   @map("category_id")
  merchantId  String   @map("merchant_id")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category Category         @relation(fields: [categoryId], references: [id])
  merchant Merchant         @relation(fields: [merchantId], references: [id])
  variants ProductVariant[]

  @@index([merchantId])
  @@index([categoryId])
  @@index([merchantId, isActive])
  @@map("products")
}

/// ProductVariant represents a specific SKU with price and stock
model ProductVariant {
  id        String   @id @default(cuid())
  productId String   @map("product_id")
  sku       String // Required SKU for idempotency in imports
  name      String // Variant name (e.g., "Talla M", "Color Rojo")
  price     Decimal  @db.Decimal(10, 2) // Price with 2 decimal places
  stock     Int      @default(0) // Available stock
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product    Product     @relation(fields: [productId], references: [id])
  cartItems  CartItem[] // PR-04: Cart items
  orderItems OrderItem[] // PR-05: Order items

  @@unique([productId, sku]) // Ensure SKU is unique per product
  @@index([productId])
  @@index([isActive])
  @@map("product_variants")
}

// ============================================================================
// PR-03.9: Transactional Outbox (Outbound WhatsApp)
// ============================================================================

enum OutboxChannel {
  WHATSAPP
}

enum OutboxMessageType {
  SEND_TEXT
}

enum OutboxMessageStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

/// Transactional outbox for reliable WhatsApp outbound messaging
/// Guarantees eventual delivery without dual-write race conditions
model OutboxMessage {
  id             String            @id @default(cuid())
  merchantId     String            @map("merchant_id")
  conversationId String?           @map("conversation_id") // PR-03.10: For outbound message logging
  channelId      String?           @map("channel_id") // PR-03.11: FK to Channel (nullable for backwards compat)
  channel        OutboxChannel
  type           OutboxMessageType
  to             String
  payloadJson    Json              @map("payload_json")
  dedupeKey      String?           @map("dedupe_key")

  status      OutboxMessageStatus @default(PENDING)
  attempts    Int                 @default(0)
  nextRetryAt DateTime            @default(now()) @map("next_retry_at")
  lockedAt    DateTime?           @map("locked_at")
  lockedBy    String?             @map("locked_by")
  lastError   String?             @map("last_error")

  providerMessageId String?   @map("provider_message_id")
  sentAt            DateTime? @map("sent_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  merchant   Merchant @relation(fields: [merchantId], references: [id])
  channelRef Channel? @relation(fields: [channelId], references: [id]) // PR-03.11

  @@unique([merchantId, dedupeKey])
  @@index([merchantId])
  @@index([status, nextRetryAt])
  @@map("outbox_messages")
}

// ============================================================================
// PR-03.11: Channel (Multi-channel support)
// ============================================================================

/// Channel represents a messaging channel (WhatsApp, Instagram, etc.) for a merchant
/// Each channel has its own credentials and external identifier
model Channel {
  id                String        @id @default(cuid())
  merchantId        String        @map("merchant_id")
  type              ChannelType
  externalId        String        @map("external_id") // phone_number_id for WhatsApp, page_id for Instagram
  displayName       String        @map("display_name") // Human-readable name (e.g., "Sucursal Centro")
  credentials       Json // { accessToken, appSecret?, phoneNumberId?, wabaId? } - TODO: encrypt in future
  isActive          Boolean       @default(true) @map("is_active")
  // PR-13: Meta Embedded Signup fields
  wabaId            String?       @map("waba_id") // WhatsApp Business Account ID
  status            ChannelStatus @default(pending)
  statusReason      String?       @map("status_reason") @db.Text
  webhookSubscribed Boolean       @default(false) @map("webhook_subscribed")
  lastWebhookAt     DateTime?     @map("last_webhook_at")
  // PR-14: Channel health tracking
  lastErrorAt       DateTime?     @map("last_error_at")
  errorCount        Int           @default(0) @map("error_count")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  merchant       Merchant        @relation(fields: [merchantId], references: [id])
  conversations  Conversation[]
  outboxMessages OutboxMessage[]

  @@unique([type, externalId])
  @@index([merchantId])
  @@index([type, externalId])
  @@index([isActive])
  @@map("channels")
}

// ============================================================================
// PR-04: Cart - Conversational Shopping Cart
// ============================================================================

/// Cart status enum
enum CartStatus {
  active     // Currently active cart
  abandoned  // TTL expired or manually cleared
  completed  // Converted to Order
}

/// Cart represents a shopping cart for a customer
model Cart {
  id         String     @id @default(cuid())
  customerId String     @map("customer_id")
  merchantId String     @map("merchant_id")
  status     CartStatus @default(active)
  expiresAt  DateTime   @map("expires_at")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  customer Customer   @relation(fields: [customerId], references: [id])
  merchant Merchant   @relation(fields: [merchantId], references: [id])
  items    CartItem[]

  @@index([customerId, merchantId, status])
  @@index([expiresAt])
  @@map("carts")
}

/// CartItem represents an item in a cart with snapshot pricing
model CartItem {
  id            String   @id @default(cuid())
  cartId        String   @map("cart_id")
  variantId     String   @map("variant_id")
  quantity      Int
  priceSnapshot Decimal  @map("price_snapshot") @db.Decimal(10, 2)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
  @@index([cartId])
  @@map("cart_items")
}

// ============================================================================// PR-12: Auth OIDC - Social Login (Google + Microsoft)
// ============================================================================

/// OidcProvider enum for supported identity providers
enum OidcProvider {
  GOOGLE
  MICROSOFT
}

/// MerchantIdentity links merchants to external OIDC providers
model MerchantIdentity {
  id          String       @id @default(cuid())
  merchantId  String       @map("merchant_id")
  provider    OidcProvider
  oidcSubject String       @map("oidc_subject") // 'sub' claim from ID token
  email       String
  createdAt   DateTime     @default(now()) @map("created_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([provider, oidcSubject])
  @@index([merchantId])
  @@index([email])
  @@map("merchant_identities")
}

/// Session stores server-side sessions for authenticated merchants
model Session {
  id         String   @id @default(cuid())
  sessionId  String   @unique @map("session_id") // UUID for cookie
  merchantId String   @map("merchant_id")
  expiresAt  DateTime @map("expires_at")
  userAgent  String?  @map("user_agent")
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([expiresAt])
  @@index([merchantId])
  @@map("sessions")
}

// ============================================================================
// PR-05: Orders - Checkout Order Creation
// ============================================================================

/// OrderStatus enum — full lifecycle of an order
enum OrderStatus {
  pending_payment // Orden creada, esperando confirmación de pago
  confirmed // Orden confirmada (COD) o pago recibido
  paid // Pago confirmado (webhook o comando manual)
  shipped // Orden enviada
  delivered // Orden entregada
  cancelled // Orden cancelada
}

/// Order represents a confirmed purchase from a customer
model Order {
  id              String      @id @default(cuid())
  orderCode       String      @map("order_code") // Código legible (e.g. ORD-001) — unique per merchant
  merchantId      String      @map("merchant_id")
  customerId      String      @map("customer_id")
  status          OrderStatus @default(pending_payment)
  totalAmount     Decimal     @map("total_amount") @db.Decimal(10, 2)
  shippingAddress String      @map("shipping_address")
  customerName    String      @map("customer_name")
  customerPhone   String      @map("customer_phone")
  paymentMethod   String      @map("payment_method") // 'cod' | 'transfer' | 'payment_link'
  notes           String?     @db.Text
  shippingCost    Decimal     @default(0) @map("shipping_cost") @db.Decimal(10, 2)
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  merchant  Merchant    @relation(fields: [merchantId], references: [id])
  customer  Customer    @relation(fields: [customerId], references: [id])
  items     OrderItem[]
  payments  Payment[]   // PR-06: Payment confirmations
  tickets   Ticket[]    // PR-07: Support tickets

  @@unique([orderCode, merchantId])
  @@index([customerId])
  @@index([merchantId, status])
  @@index([createdAt(sort: Desc)])
  @@map("orders")
}

// ============================================================================
// PR-06: Payments — Webhook idempotente + fallback comando PAGADO
// ============================================================================

/// PaymentStatus enum — lifecycle of a payment
enum PaymentStatus {
  pending   // Pago iniciado, esperando confirmación
  confirmed // Pago confirmado (webhook o comando manual)
  failed    // Pago fallido (webhook con status rejected)
}

/// Payment — tracks payment confirmations for orders
/// Idempotency: unique constraint on paymentIntentId (AC-08)
model Payment {
  id              String        @id @default(cuid())
  orderId         String        @map("order_id")
  amount          Decimal       @db.Decimal(10, 2)
  method          String        // 'cod' | 'transfer' | 'payment_link'
  status          PaymentStatus @default(pending)
  externalId      String?       @map("external_id") // ID del gateway externo
  paymentIntentId String        @unique @map("payment_intent_id") // DB-level idempotency key
  confirmedAt     DateTime?     @map("confirmed_at")
  metadata        Json?
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([status])
  @@map("payments")
}

// ============================================================================
// PR-07: Tickets — Post-sale support tickets
// ============================================================================

/// TicketType enum — type of post-sale issue
enum TicketType {
  missing  // Producto faltante
  damaged  // Producto dañado
  delay    // Retraso en entrega
  other    // Otro problema
}

/// TicketStatus enum — lifecycle of a support ticket
enum TicketStatus {
  open     // Ticket abierto (pendiente)
  resolved // Resuelto por merchant
  closed   // Cerrado
}

/// Ticket — customer opens a post-sale issue for an order
model Ticket {
  id          String       @id @default(cuid())
  orderId     String       @map("order_id")
  customerId  String       @map("customer_id")
  merchantId  String       @map("merchant_id")
  type        TicketType
  status      TicketStatus @default(open)
  description String       @db.Text
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  order    Order    @relation(fields: [orderId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@index([orderId])
  @@index([customerId])
  @@index([merchantId, status])
  @@map("tickets")
}

// ============================================================================
// PR-08: Handoff — Human handoff with structured summary
// ============================================================================

/// HandoffStatus enum — lifecycle of a human handoff
enum HandoffStatus {
  pending  // Handoff requested, waiting for merchant
  active   // Merchant is actively attending
  resolved // Resolved, bot can resume
}

/// Handoff — persists human handoff sessions with structured summary
/// Idempotency: at most one pending/active handoff per conversation
model Handoff {
  id             String        @id @default(cuid())
  conversationId String        @map("conversation_id")
  reason         String        // "user_request" | "auto_escalation"
  summaryJson    Json          @map("summary_json") // HandoffSummary structure
  status         HandoffStatus @default(pending)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId, status])
  @@map("handoffs")
}

/// OrderItem represents a line item in an order (snapshot of product at time of purchase)
model OrderItem {
  id           String   @id @default(cuid())
  orderId      String   @map("order_id")
  variantId    String   @map("variant_id")
  quantity     Int
  unitPrice    Decimal  @map("unit_price") @db.Decimal(10, 2) // Snapshot at purchase time
  snapshotName String   @map("snapshot_name") // "Product name - Variant name" snapshot
  createdAt    DateTime @default(now()) @map("created_at")

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@map("order_items")
}
