# Database
DATABASE_URL="postgresql://closy:closy_dev_password@localhost:5432/closy_dev?schema=public"

# Application
NODE_ENV="development"
PORT=3000

# PR-FE-00: CORS Configuration (Cross-Origin Resource Sharing)
# Comma-separated list of allowed origins for cross-origin requests
# Required for dashboard frontend to communicate with backend API
# Default (dev): http://localhost:3001 (Next.js dashboard)
# Production example: https://dashboard.closybot.com
# Multiple origins: http://localhost:3001,https://dashboard.closybot.com
CORS_ORIGINS="http://localhost:3001"

# Logging
LOG_LEVEL="debug"

# Merchant API Authentication
# Each merchant requires a unique API key to access the catalog management API
# Generate secure random keys in production (e.g., using crypto.randomBytes)
# Example: MERCHANT_API_KEY_<merchantId>=<secure-random-key>

# WhatsApp Cloud API
# Get these values from: https://developers.facebook.com/apps/
# NOTE (PR-03.11): These are fallback credentials for backwards compatibility.
# For multi-channel support, configure channels via database (see Channel model).
# Each merchant can have multiple WhatsApp channels with different phone_number_id values.
# Migration creates a default channel per merchant using these env vars as placeholders.
WHATSAPP_ACCESS_TOKEN="EAAxxxxxxx"
WHATSAPP_PHONE_NUMBER_ID="123456789"
WHATSAPP_API_VERSION="v18.0"
WHATSAPP_API_URL="https://graph.facebook.com"

# WhatsApp Webhook Configuration
# Verify token: Custom string you define (used for webhook verification)
WHATSAPP_WEBHOOK_VERIFY_TOKEN="your-custom-verify-token-here"
# App Secret: Found in Meta App Settings > Basic (used for signature validation)
# NOTE: For OAuth/onboarding channels (PR-13), use META_APP_SECRET instead.
# This WHATSAPP_APP_SECRET is for legacy/fallback channel webhook validation.
WHATSAPP_APP_SECRET="your-app-secret-from-meta-dashboard"

# LLM Configuration
# Enable/disable LLM-powered responses (defaults to templated responses when false)
LLM_ENABLED=false
# LLM provider (currently only 'groq' supported)
LLM_PROVIDER=groq
# Groq API key (get from: https://console.groq.com/keys)
# Required when LLM_ENABLED=true
GROQ_API_KEY=gsk_xxxxx
# Model to use (see: https://console.groq.com/docs/models)
# Recommended: llama-3.1-70b-versatile (good balance of quality/speed)
LLM_MODEL=llama-3.1-70b-versatile
# Max response time in milliseconds before timeout
LLM_TIMEOUT_MS=30000
# Max tokens to generate per response (lower = faster & cheaper)
LLM_MAX_TOKENS=500
# Temperature for sampling (0 = deterministic, 2 = very creative)
LLM_TEMPERATURE=0.7

# Outbox Dispatcher Configuration
# Enable/disable outbox dispatcher (for transactional outbound messaging)
OUTBOX_DISPATCHER_ENABLED=true
# Batch size for processing messages per cycle
OUTBOX_BATCH_SIZE=10
# Lock TTL in seconds (to reclaim stuck messages)
OUTBOX_LOCK_TTL_SECONDS=300
# Max retry attempts before message is marked as permanently failed
OUTBOX_MAX_ATTEMPTS=5

# PR-03.10: Message Retention Configuration
# TTL in days for message history (aligned with WhatsApp reply quote limit)
MESSAGE_HISTORY_DAYS=30
# Max messages per conversation before applying cap (safety limit)
MESSAGE_HISTORY_MAX_PER_CONVO=50
# Number of recent messages to include in LLM context (lower = cheaper)
LLM_CONTEXT_LAST_K=10
# Batch size for summarization job (conversations per run)
SUMMARIZATION_BATCH_SIZE=20

# PR-12: Auth Configuration (OIDC Social Login)
# Google OAuth 2.0 credentials (get from: https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxxxx"

# Microsoft Azure AD credentials (get from: https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps)
MICROSOFT_CLIENT_ID="your-microsoft-client-id"
MICROSOFT_CLIENT_SECRET="your-microsoft-client-secret"

# Auth session configuration
# Base URL for OAuth callbacks (include protocol and domain, no trailing slash)
AUTH_REDIRECT_URL="http://localhost:3000"
# Session TTL in hours (default: 24 hours)
AUTH_SESSION_TTL_HOURS=24
# Cookie domain (optional, auto-detect if not set)
# Example: ".yourdomain.com" for subdomain support
AUTH_COOKIE_DOMAIN=""
# Session cleanup cron expression (default: every 6 hours)
# Format: "second minute hour day month weekday"
AUTH_SESSION_CLEANUP_CRON="0 */6 * * *"

# PR-13: Meta Embedded Signup (WhatsApp Channel Onboarding)
# Meta App credentials (get from: https://developers.facebook.com/apps/)
# App ID: Found in App Dashboard > Settings > Basic
META_APP_ID="your-meta-app-id"
# App Secret: Found in App Dashboard > Settings > Basic (keep this secret!)
META_APP_SECRET="your-meta-app-secret"
# Embedded Signup Config ID: Create in App Dashboard > WhatsApp > API Setup > Embedded Signup
META_CONFIG_ID="your-config-id"
# Redirect URI for OAuth callback (must match Meta App Dashboard settings)
# Format: {AUTH_REDIRECT_URL}/onboarding/whatsapp/callback
META_REDIRECT_URI="http://localhost:3000/onboarding/whatsapp/callback"

# PR-14: Channel Health Configuration (optional, defaults in code)
# Rate limiting for retry/refresh operations
# CHANNEL_HEALTH_RATE_LIMIT_TTL=60000  # 60 seconds (default)
# CHANNEL_HEALTH_RATE_LIMIT_MAX=5      # 5 requests per TTL (default)

# PR-17: Catalog Import File Upload Configuration
# Maximum file size in MB for CSV import (default: 5MB)
CATALOG_IMPORT_MAX_SIZE_MB=5
