# ─────────────────────────────────────────────────────────────────────────────
# Workspace-level .env
# Only vars needed for Prisma commands run from the repo root (pnpm db:*).
#
# App-specific configuration:
#   API:       apps/api/.env.example  → copy to apps/api/.env
#   Dashboard: apps/dashboard/.env.example → copy to apps/dashboard/.env
# ─────────────────────────────────────────────────────────────────────────────

# Required for: pnpm db:generate | db:migrate | db:push | db:studio | db:seed
# Must match docker-compose.yml credentials (or your own PostgreSQL instance)
DATABASE_URL=postgresql://closy:closy_dev_password@localhost:5432/closy_dev

