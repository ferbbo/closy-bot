# ──────────────────────────────────────────────
# Core
# ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ──────────────────────────────────────────────
# Database (PostgreSQL / Supabase)
# ──────────────────────────────────────────────
# Local development (matches docker-compose.yml credentials):
DATABASE_URL=postgresql://closy:closy_dev_password@localhost:5432/closy_dev

# Production (Supabase) - use pooler for runtime, direct for migrations:
# DATABASE_URL=postgresql://postgres.[PROJECT]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres.[PROJECT]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# ──────────────────────────────────────────────
# CORS
# ──────────────────────────────────────────────
# Comma-separated list of allowed origins (e.g., http://localhost:3001,https://dashboard.closy.bot)
CORS_ORIGINS=http://localhost:3001

# ──────────────────────────────────────────────
# WhatsApp Cloud API
# ──────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v18.0
WHATSAPP_API_URL=https://graph.facebook.com
# Custom string used for webhook verification handshake
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-verify-token
# App Secret from Meta App Settings > Basic — used for HMAC signature validation
WHATSAPP_APP_SECRET=your-app-secret-from-meta-dashboard
# Delivery S1.5: true only with the local Meta Sandbox (pnpm meta:sandbox); never in production
WHATSAPP_SANDBOX=false

# ──────────────────────────────────────────────
# LLM (Groq)
# ──────────────────────────────────────────────
# DEPRECATED monolithic flag — use granular flags below instead
LLM_ENABLED=false
LLM_PROVIDER=groq
GROQ_API_KEY=
LLM_MODEL=llama-3.1-70b-versatile
LLM_TIMEOUT_MS=30000
LLM_MAX_TOKENS=500
LLM_TEMPERATURE=0.7

# PR-03.5.1: Granular LLM feature flags
LLM_INTENT_ASSIST=false
LLM_FALLBACK_ENABLED=false
LLM_SUMMARY_ENABLED=false

# ──────────────────────────────────────────────
# Intent Classification (PR-03.5.1)
# ──────────────────────────────────────────────
# score >= HIGH → HIGH confidence; score >= LOW → MED; below LOW → LOW
INTENT_CONFIDENCE_THRESHOLD_HIGH=5
INTENT_CONFIDENCE_THRESHOLD_LOW=2

# ──────────────────────────────────────────────
# Message retention (PR-03.10)
# ──────────────────────────────────────────────
MESSAGE_HISTORY_DAYS=30
MESSAGE_HISTORY_MAX_PER_CONVO=50
LLM_CONTEXT_LAST_K=10
SUMMARIZATION_BATCH_SIZE=20

# ──────────────────────────────────────────────
# Outbox dispatcher
# ──────────────────────────────────────────────
OUTBOX_DISPATCHER_ENABLED=true
OUTBOX_BATCH_SIZE=10
OUTBOX_LOCK_TTL_SECONDS=300
OUTBOX_MAX_ATTEMPTS=5

# ──────────────────────────────────────────────
# Catalog (PR-03.5.2 / PR-17)
# ──────────────────────────────────────────────
CATALOG_FTS_ENABLED=true
# Maximum file size in MB for CSV import
CATALOG_IMPORT_MAX_SIZE_MB=5

# ──────────────────────────────────────────────
# Cart (PR-04)
# ──────────────────────────────────────────────
# TTL in hours — carts older than this are marked abandoned
CART_TTL_HOURS=24

# ──────────────────────────────────────────────
# FAQ (PR-GAP-2)
# ──────────────────────────────────────────────
# Minimum keyword matches required to trigger an FAQ answer
FAQ_MATCH_THRESHOLD=1

# ──────────────────────────────────────────────
# Payment Webhook (PR-06)
# ──────────────────────────────────────────────
# Secret for HMAC SHA-256 signature validation (skip validation if empty in dev)
PAYMENT_WEBHOOK_SECRET=your-payment-webhook-secret
# Header name sent by the payment gateway with the HMAC signature
PAYMENT_WEBHOOK_HEADER=X-Payment-Signature

# ──────────────────────────────────────────────
# Auth OIDC (PR-12)
# ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
AUTH_REDIRECT_URL=http://localhost:3000
AUTH_SESSION_TTL_HOURS=24
AUTH_COOKIE_DOMAIN=
AUTH_SESSION_CLEANUP_CRON=0 */6 * * *

# Dashboard origin — used by the API as postMessage targetOrigin (GAP-3 security).
# Set to the dashboard URL, NOT the API URL. Never leave this as '*'.
# Production: https://dashboard.closy.bot
DASHBOARD_URL=http://localhost:3001

# ──────────────────────────────────────────────
# Meta Embedded Signup (PR-13)
# ──────────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
META_REDIRECT_URI=http://localhost:3000/onboarding/whatsapp/callback

# ──────────────────────────────────────────────
# Feature Flags (PR-MVP-01)
# Kill-switch: mvp → all B2 flags forced to false (safe for production)
# Use dev/full ONLY in non-production environments
# ──────────────────────────────────────────────
FEATURES_MODE=mvp
MULTI_CHANNEL_ENABLED=false
INSTAGRAM_ENABLED=false
PLAYBOOK_EDITOR_ENABLED=false
INDUSTRIES_ENABLED=false

# Delivery vertical (Closy Delivery Agent, B2): solo activo si FEATURES_MODE != mvp
DELIVERY_ENABLED=false
DELIVERY_LLM_MODEL=llama-3.3-70b-versatile
DELIVERY_STT_MODEL=whisper-large-v3-turbo
DELIVERY_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# ──────────────────────────────────────────────
# Cloudflare R2 (PR-INFRA-R2)
# Pre-requisito de PR-18 (Product Images API)
# Todas opcionales: la API arranca sin ellas.
# Ver docs/setup/cloudflare-r2-setup.md
# ──────────────────────────────────────────────
# Cloudflare Account ID (visible en el sidebar del dashboard)
R2_ACCOUNT_ID=
# R2 API Access Key (S3-compatible) — generado en R2 → Manage R2 API tokens
R2_ACCESS_KEY_ID=
# R2 API Secret Key — mostrado una sola vez al crear el token
R2_SECRET_ACCESS_KEY=
# Nombre del bucket R2 creado en el dashboard
R2_BUCKET_NAME=closy-bot-products
# URL base pública del CDN: R2.dev subdomain o custom domain (ej: https://cdn.closy.bot)
R2_PUBLIC_URL=
