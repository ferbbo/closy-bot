{
  "name": "closy-bot",
  "version": "1.0.0",
  "description": "Core V1 MVP - WhatsApp conversational commerce for PYMEs",
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @closy-bot/api run start:dev",
    "build": "pnpm --filter @closy-bot/api run build",
    "start": "pnpm --filter @closy-bot/api run start:prod",
    "lint": "pnpm --filter @closy-bot/api run lint",
    "format": "pnpm --filter @closy-bot/api run format",
    "test": "pnpm --filter @closy-bot/api run test",
    "test:watch": "pnpm --filter @closy-bot/api run test:watch",
    "test:cov": "pnpm --filter @closy-bot/api run test:cov",
    "test:e2e": "pnpm --filter @closy-bot/api run test:e2e",
    "db:generate": "pnpm --filter @closy-bot/api exec prisma generate",
    "db:migrate": "pnpm --filter @closy-bot/api exec prisma migrate dev",
    "db:push": "pnpm --filter @closy-bot/api exec prisma db push",
    "db:studio": "pnpm --filter @closy-bot/api exec prisma studio",
    "db:seed": "pnpm --filter @closy-bot/api exec tsx ../../prisma/seed.ts"
  },
  "keywords": [
    "whatsapp",
    "conversational-commerce",
    "chatbot",
    "nestjs"
  ],
  "author": "Closy Bot Team",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.25.0",
  "devDependencies": {
    "prisma": "5.22.0"
  },
  "dependencies": {
    "@prisma/client": "5.22.0"
  }
}
